<!DOCTYPE html>
<html lang="pt-br">
<head>
 </head>
<body>
    <title>Testando</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <h2>Listagem de Autores</h2>
    <a href="http://localhost:3000/autores/add" class="btn btn-success" style="margin-bottom: 10px;">Incluir</a>
<table class="table">
<thead>
<tr>
<th scope = "col">#</th>
<th scope = "col">Autor</th>
<th scope = "col">Nacionalidade</th>
<th scope = "col">Operações</th>
</tr>
</thead>
<tbody>
<% for (item of resultado) {%>
<tr>
<td scope = "row"><%=item.IdAutor%></td>
<td scope = "row"><%=item.NoAutor%></td>
<td scope = "row"><%=item.NoNacionalidade%></td>
<td>
    <a href="/autores/edit/<%=item.IdAutor%>" class="btn btn-primary">Editar</a>
    <a href="/autores/delete/<%=item.IdAutor%>" class="btn btn-danger">Excluir</a>
    </td>
</tr>
<%}%>
</tbody>
</table>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>

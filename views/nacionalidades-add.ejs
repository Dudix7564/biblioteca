<!DOCTYPE html>
<html>

<head>
    <title>Cadastro de Nacionalidades</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-
GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">
</head>
<body>
    <h1>Cadastro de Autores</h1>
    <form method = "post" action = "/nacionalidades/add" class="row g-3">
        <div class="col-md-6">
            <label for="inputNacionalidades" class="form-label">Nacionalidades</label>
            <input type="text" class="form-control" id="inputNacionalidades" name="nacionalidades" placeholder="Inserir nacionalidade">
        </div>
        <div class="col-md-6">
            <label for="inputIdNacionalidade" class="form-label">IdNacionalidade</label>
            <input type="number" class="form-control" id="inputIdNacionalidade" name="Idnacionalidade" placeholder="Inserir Id da nacionalidade">
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Cadastrar</button>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" integrity="sha384-
w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN" crossorigin="anonymous"></script>
</body>

</html>